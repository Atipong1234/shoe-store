# Connection string จาก Neon (Dashboard > Connection Details)
# ตัวอย่าง: postgres://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://user:password@your-neon-host/dbname?sslmode=require

# รหัสลับสำหรับเซ็น JWT (ตั้งเป็นข้อความสุ่มยาวๆ)
JWT_SECRET=change-this-to-a-long-random-string

# บัญชีแอดมินเริ่มต้น (จะถูกสร้างอัตโนมัติตอนรันครั้งแรกถ้ายังไม่มี)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

PORT=3000
